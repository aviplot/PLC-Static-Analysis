<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Only checks a formatter cannot express. Layout, whitespace, braces and import order belong to
  Spotless (palantir-java-format); nothing here may overlap with it.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>

    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>

    <module name="TreeWalker">
        <!-- imports -->
        <module name="AvoidStarImport">
            <!-- generated parse-tree contexts: dozens of nested classes used by the AST builder -->
            <property name="excludes" value="dev.plca.grammar.CodesysStParser"/>
        </module>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport"/>

        <!-- naming -->
        <module name="PackageName">
            <property name="format" value="^dev\.plca(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>
        <module name="StaticVariableName"/>
        <module name="ClassTypeParameterName">
            <property name="format" value="^[A-Z][A-Z0-9]?$"/>
        </module>
        <module name="MethodTypeParameterName">
            <property name="format" value="^[A-Z][A-Z0-9]?$"/>
        </module>

        <!-- correctness -->
        <module name="EqualsHashCode"/>
        <module name="OneTopLevelClass"/>
        <module name="MissingOverride"/>
        <module name="FallThrough"/>
        <module name="StringLiteralEquality"/>
        <module name="MethodLength">
            <property name="max" value="150"/>
        </module>

        <!-- libraries report through DiagnosticSink, never the console (plc-cli is exempt) -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="noConsole"/>
            <property name="format" value="System\.(out|err)\.|\.printStackTrace\(\)"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Report via DiagnosticSink or a logger, not the console."/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="@author\b"/>
            <property name="message" value="No @author tags; git history records authorship."/>
        </module>
    </module>
</module>
