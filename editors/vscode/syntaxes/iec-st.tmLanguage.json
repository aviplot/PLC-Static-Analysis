{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Structured Text (IEC 61131-3)",
  "scopeName": "source.iec-st",
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#pragmas"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#literals"
        },
        {
          "include": "#addresses"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#calls"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "include": "#block-comment"
        },
        {
          "name": "comment.block.c-style.iec-st",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.iec-st",
          "match": "//.*$"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.iec-st",
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "pragmas": {
      "name": "meta.preprocessor.pragma.iec-st",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.pragma.begin.iec-st"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.pragma.end.iec-st"
        }
      },
      "patterns": [
        {
          "name": "keyword.other.pragma.iec-st",
          "match": "(?i)\\b(?:attribute|IF|ELSIF|ELSE|END_IF|defined|hasattribute|hastype|hasvalue|warning|error|info|text|region|endregion|library)\\b"
        },
        {
          "name": "string.quoted.single.iec-st",
          "match": "'[^']*'"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.iec-st",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.iec-st",
              "match": "\\$(?:[0-9A-Fa-f]{2}|[$'LlNnPpRrTt])"
            }
          ]
        },
        {
          "name": "string.quoted.double.iec-st",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.iec-st",
              "match": "\\$(?:[0-9A-Fa-f]{4}|[$\\\"LlNnPpRrTt])"
            }
          ]
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.duration.iec-st",
          "match": "(?i)\\b(?:LTIME|LT|TIME|T)#[+-]?(?:[0-9_.]+(?:d|h|ms|m|s|us|ns))+\\b"
        },
        {
          "name": "constant.numeric.date.iec-st",
          "match": "(?i)\\b(?:LDATE_AND_TIME|DATE_AND_TIME|LDT|DT)#\\d{4}-\\d{1,2}-\\d{1,2}-\\d{1,2}:\\d{1,2}(?::\\d{1,2}(?:\\.\\d+)?)?"
        },
        {
          "name": "constant.numeric.date.iec-st",
          "match": "(?i)\\b(?:LDATE|DATE|D)#\\d{4}-\\d{1,2}-\\d{1,2}\\b"
        },
        {
          "name": "constant.numeric.date.iec-st",
          "match": "(?i)\\b(?:LTIME_OF_DAY|TIME_OF_DAY|LTOD|TOD)#\\d{1,2}:\\d{1,2}(?::\\d{1,2}(?:\\.\\d+)?)?"
        },
        {
          "name": "constant.numeric.based.iec-st",
          "match": "(?i)\\b(?:[A-Z_]+#)?(?:2|8|16)#[0-9A-F_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.iec-st",
          "match": "(?i)\\b(?:[A-Z_]+#)?\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:E[+-]?\\d+)?\\b"
        },
        {
          "name": "constant.language.iec-st",
          "match": "(?i)\\b(?:FALSE|NULL|TRUE)\\b"
        }
      ]
    },
    "addresses": {
      "name": "variable.other.address.iec-st",
      "match": "(?i)%[IQM](?:\\*|[XBWDL]?\\d+(?:\\.\\d+)*)"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.iec-st",
          "match": "(?i)\\b(?:END_REPEAT|END_WHILE|__FINALLY|CONTINUE|END_CASE|__ENDTRY|END_FOR|__CATCH|END_IF|REPEAT|RETURN|ELSIF|UNTIL|WHILE|__TRY|CASE|ELSE|EXIT|THEN|FOR|JMP|BY|DO|IF|OF|TO)\\b"
        },
        {
          "name": "storage.type.var.iec-st",
          "match": "(?i)\\b(?:VAR_EXTERNAL|VAR_ACCESS|VAR_CONFIG|VAR_GLOBAL|VAR_IN_OUT|VAR_OUTPUT|VAR_INPUT|VAR_INST|VAR_STAT|VAR_TEMP|END_VAR|VAR)\\b"
        },
        {
          "name": "keyword.other.declaration.iec-st",
          "match": "(?i)\\b(?:END_FUNCTION_BLOCK|END_CONFIGURATION|END_TRANSITION|FUNCTION_BLOCK|CONFIGURATION|END_INTERFACE|END_NAMESPACE|END_FUNCTION|END_PROPERTY|END_RESOURCE|INITIAL_STEP|END_PROGRAM|END_ACTION|END_METHOD|END_STRUCT|IMPLEMENTS|TRANSITION|END_CLASS|END_UNION|INTERFACE|NAMESPACE|END_STEP|END_TYPE|FUNCTION|PROPERTY|RESOURCE|END_GET|END_SET|EXTENDS|PROGRAM|ACTION|METHOD|STRUCT|CLASS|UNION|USING|FROM|STEP|TASK|TYPE|WITH|GET|SET|ON)\\b"
        },
        {
          "name": "storage.modifier.iec-st",
          "match": "(?i)\\b(?:NON_RETAIN|PERSISTENT|READ_WRITE|PROTECTED|READ_ONLY|ABSTRACT|CONSTANT|INTERNAL|OVERRIDE|PRIVATE|PUBLIC|RETAIN|FINAL|AT)\\b"
        },
        {
          "name": "support.type.elementary.iec-st",
          "match": "(?i)\\b(?:LDATE_AND_TIME|DATE_AND_TIME|LTIME_OF_DAY|TIME_OF_DAY|ANY_STRING|REFERENCE|ANY_DATE|ANY_REAL|ANY_BIT|ANY_INT|ANY_NUM|POINTER|WSTRING|__UXINT|__XWORD|REF_TO|STRING|__XINT|ARRAY|DWORD|LDATE|LREAL|LTIME|LWORD|PVOID|UDINT|ULINT|USINT|WCHAR|XWORD|BOOL|BYTE|CHAR|DATE|DINT|LINT|LTOD|REAL|SINT|TIME|UINT|WORD|ANY|BIT|INT|LDT|TOD|DT)\\b"
        },
        {
          "name": "variable.language.iec-st",
          "match": "(?i)\\b(?:SUPER|THIS)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.iec-st",
          "match": "(?i)\\b(?:AND_THEN|OR_ELSE|AND|MOD|NOT|XOR|OR)\\b"
        },
        {
          "name": "keyword.operator.assignment.iec-st",
          "match": "(?i):=|=>|\\?=|\\bS=|\\bR=|\\bREF="
        },
        {
          "name": "keyword.operator.comparison.iec-st",
          "match": "<>|<=|>=|<|>|="
        },
        {
          "name": "keyword.operator.arithmetic.iec-st",
          "match": "\\*\\*|\\+|-|\\*|/|&"
        },
        {
          "name": "keyword.operator.dereference.iec-st",
          "match": "\\^"
        }
      ]
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.iec-st"
        }
      }
    }
  }
}
