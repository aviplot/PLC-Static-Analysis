{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rockwell L5X export",
  "scopeName": "text.xml.l5x",
  "patterns": [
    {
      "begin": "(<)(Text)\\b([^>]*)(>)",
      "end": "(</)(\\2)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.xml"
        },
        "2": {
          "name": "entity.name.tag.xml"
        },
        "3": {
          "patterns": [
            {
              "include": "text.xml"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.xml"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.xml"
        },
        "2": {
          "name": "entity.name.tag.xml"
        },
        "3": {
          "name": "punctuation.definition.tag.xml"
        }
      },
      "patterns": [
        {
          "begin": "<!\\[CDATA\\[",
          "end": "\\]\\]>",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.xml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.xml"
            }
          },
          "contentName": "meta.embedded.block.rockwell-rll",
          "patterns": [
            {
              "include": "source.rockwell-rll"
            }
          ]
        }
      ]
    },
    {
      "begin": "(<)(Line)\\b([^>]*)(>)",
      "end": "(</)(\\2)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.xml"
        },
        "2": {
          "name": "entity.name.tag.xml"
        },
        "3": {
          "patterns": [
            {
              "include": "text.xml"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.xml"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.xml"
        },
        "2": {
          "name": "entity.name.tag.xml"
        },
        "3": {
          "name": "punctuation.definition.tag.xml"
        }
      },
      "patterns": [
        {
          "begin": "<!\\[CDATA\\[",
          "end": "\\]\\]>",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.xml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.xml"
            }
          },
          "contentName": "meta.embedded.block.iec-st",
          "patterns": [
            {
              "include": "source.iec-st"
            }
          ]
        }
      ]
    },
    {
      "include": "text.xml"
    }
  ]
}
