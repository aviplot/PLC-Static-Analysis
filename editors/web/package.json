{
  "name": "plca-workbench",
  "version": "0.1.0",
  "description": "PLC code review workbench: the browser app served by `plca web`.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "bundle": "npm run typecheck && node scripts/build.mjs",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "fflate": "0.8.2",
    "monaco-editor": "0.57.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
