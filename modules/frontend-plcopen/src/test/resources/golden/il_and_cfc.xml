      <pou name="Il_Limit" pouType="function">
        <interface>
          <returnType><INT /></returnType>
          <inputVars>
            <variable name="nIn"><type><INT /></type></variable>
            <variable name="nMax"><type><INT /></type></variable>
          </inputVars>
        </interface>
        <body>
          <IL>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">LD   nIn
GT   nMax     (* above the limit? *)
JMPC Clip
LD   nIn
ST   Il_Limit
RET
Clip:
LD   nMax
ST   Il_Limit</xhtml>
          </IL>
        </body>
      </pou>
