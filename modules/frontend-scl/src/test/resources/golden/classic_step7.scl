FUNCTION_BLOCK FB10
TITLE = 'Classic STEP 7 SCL'
KNOW_HOW_PROTECT
AUTHOR : ACME
VERSION : '0.3'

CONST
    LIMIT := 100;
    FACTOR := 2.5;
END_CONST

LABEL
    LBL_END;
END_LABEL

VAR_INPUT
    In1 : INT;
END_VAR
VAR
    Count : INT;
END_VAR

BEGIN
    Count := Count + In1;
    IF Count > LIMIT THEN
        GOTO LBL_END;
    END_IF;
    DB10.DBW2 := INT_TO_WORD(Count);
    DB10.DBX4.1 := TRUE;
    Count := WORD_TO_INT(DB10.DW6);
LBL_END:
    ;
END_FUNCTION_BLOCK

DATA_BLOCK DB10 FB10
BEGIN
END_DATA_BLOCK

