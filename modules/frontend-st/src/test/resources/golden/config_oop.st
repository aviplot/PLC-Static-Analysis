NAMESPACE Lib.Motion
USING Lib.Base, Other;
INTERFACE I_Axis EXTENDS I_Base, I_Diag
METHOD MoveAbs : BOOL
VAR_INPUT
    pos : LREAL;
END_VAR
END_METHOD
PROPERTY Position : LREAL
END_PROPERTY
END_INTERFACE
CLASS FINAL C_Axis IMPLEMENTS I_Axis
VAR PUBLIC
    pos : LREAL;
END_VAR
METHOD PUBLIC OVERRIDE MoveAbs : BOOL
MoveAbs := TRUE;
END_METHOD
END_CLASS
END_NAMESPACE

CONFIGURATION Cfg
VAR_GLOBAL
    gRun : BOOL;
END_VAR
RESOURCE Res ON PLC
    TASK Fast(INTERVAL := T#10MS, PRIORITY := 1);
    PROGRAM Main WITH Fast : MAIN;
END_RESOURCE
END_CONFIGURATION
