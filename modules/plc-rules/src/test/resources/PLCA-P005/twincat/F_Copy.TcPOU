<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="F_Copy" Id="{00000000-0000-0000-0000-000000000001}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_Copy : BOOL
VAR_INPUT
    pSrc : POINTER TO DINT;
    pDst : POINTER TO DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF pSrc <> 0 THEN
    pDst^ := pSrc^; // PLCA-P005
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
