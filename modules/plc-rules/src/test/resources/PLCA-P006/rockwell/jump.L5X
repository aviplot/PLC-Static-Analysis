<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="Cell" TargetType="Controller" ContainsContext="false">
<Controller Use="Target" Name="Cell">
<Tags>
<Tag Name="Skip" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Start" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Lamp" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
</Tags>
<Programs>
<Program Name="MainProgram" MainRoutineName="Main" Disabled="false">
<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[XIC(Skip)JMP(Over);]]></Text></Rung> <!-- PLCA-P006 -->
<Rung Number="1" Type="N"><Text><![CDATA[XIC(Start)OTE(Lamp);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[LBL(Over)[XIC(Start) ,XIO(Skip)JMP(Over) ];]]></Text></Rung> <!-- PLCA-P006 -->
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
