<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="Cell" TargetType="Controller" ContainsContext="false">
<Controller Use="Target" Name="Cell">
<Tags>
<Tag Name="A" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="B" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="R" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Go" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
</Tags>
<Programs>
<Program Name="MainProgram" MainRoutineName="Main" Disabled="false">
<Tags>
</Tags>
<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[XIC(Go)DIV(A,0,B);]]></Text></Rung> <!-- PLCA-Q004 -->
<Rung Number="1" Type="N"><Text><![CDATA[XIC(Go)DIV(A,B,B);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[XIC(Go)CPT(R,A/(B-B));]]></Text></Rung>
<Rung Number="3" Type="N"><Text><![CDATA[XIC(Go)MOD(A,0,B);]]></Text></Rung> <!-- PLCA-Q004 -->
