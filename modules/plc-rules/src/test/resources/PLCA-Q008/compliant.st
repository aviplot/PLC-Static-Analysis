PROGRAM P_Main2
VAR
    nCount : INT;
END_VAR
nCount := F_Used2(nCount);
END_PROGRAM

FUNCTION F_Used2 : INT
VAR_INPUT
    n : INT;
END_VAR
F_Used2 := n + 1;
END_FUNCTION

CONFIGURATION Cfg2
    RESOURCE Res2 ON PLC
        TASK tMain2(INTERVAL := T#10MS, PRIORITY := 1);
        PROGRAM iMain2 WITH tMain2 : P_Main2;
    END_RESOURCE
END_CONFIGURATION
