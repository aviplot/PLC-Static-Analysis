<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="Cell" TargetType="Controller" ContainsContext="false">
<Controller Use="Target" Name="Cell">
<Tags>
<Tag Name="Ready" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Count" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write"/>
</Tags>
<Programs>
<Program Name="MainProgram" MainRoutineName="Main" Disabled="false">
<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0"><![CDATA[WHILE NOT Ready DO]]></Line> <!-- PLCA-Q012 -->
<Line Number="1"><![CDATA[    Count := Count + 1;]]></Line>
<Line Number="2"><![CDATA[END_WHILE;]]></Line>
<Line Number="3"><![CDATA[WHILE Count < 10 DO]]></Line>
<Line Number="4"><![CDATA[    Count := Count + 1;]]></Line>
<Line Number="5"><![CDATA[END_WHILE;]]></Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
