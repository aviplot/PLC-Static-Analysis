<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="Cell" TargetType="Controller" ContainsContext="false">
<Controller Use="Target" Name="Cell">
<Tags>
<Tag Name="HmiStart" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="HmiLocked" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read Only"/>
<Tag Name="HmiIndex" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Fault" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Table" TagType="Base" DataType="DINT" Dimensions="10" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Value" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Pump" TagType="Alias" AliasFor="Local:2:O.Data.0" ExternalAccess="Read/Write"/>
</Tags>
<Programs>
<Program Name="MainProgram" MainRoutineName="Main" Disabled="false">
<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[XIC(HmiStart)OTE(Local:2:O.Data.1);]]></Text></Rung> <!-- PLCA-S002 -->
<Rung Number="1" Type="N"><Text><![CDATA[XIC(HmiStart)XIO(Fault)OTE(Pump);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[XIC(HmiLocked)OTE(Local:2:O.Data.2);]]></Text></Rung>
<Rung Number="3" Type="N"><Text><![CDATA[MOV(Table[HmiIndex],Value);]]></Text></Rung> <!-- PLCA-S002 -->
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
