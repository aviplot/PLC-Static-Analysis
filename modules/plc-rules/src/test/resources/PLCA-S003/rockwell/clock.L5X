<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="Cell" TargetType="Controller" ContainsContext="false">
<Controller Use="Target" Name="Cell">
<Tags>
<Tag Name="Clock" TagType="Base" DataType="DINT" Dimensions="7" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Run" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
</Tags>
<Programs>
<Program Name="MainProgram" MainRoutineName="Main" Disabled="false">
<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[GSV(WallClockTime,?,LocalDateTime,Clock[0]);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[GEQ(Clock[0],2027)OTU(Run);]]></Text></Rung> <!-- PLCA-S003 -->
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
