<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="Cell" TargetType="Controller" ContainsContext="false">
<Controller Use="Target" Name="Cell">
<Tags>
<Tag Name="Start" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Stop" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Fault" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Lamp" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Horn" TagType="Alias" AliasFor="Out" ExternalAccess="2"/>
<Tag Name="Pump" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write"/>
</Tags>
<Programs>
<Program Name="MainProgram" MainRoutineName="Main" Disabled="false">
<Tags>
<Tag Name="Seal" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="None"/>
<Tag Name="Step" TagType="Base" DataType="DINT" Constant="false" ExternalAccess="None"/>
</Tags>
<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[[XIC(Start) ,XIC(Seal) ]XIO(Stop)OTE(Seal);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[XIC(Seal)OTE(Lamp);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[XIC(Fault)OTE(Lamp);]]></Text></Rung> <!-- PLCA-P001 second coil of Lamp in the same routine -->
<Rung Number="3" Type="N"><Text><![CDATA[XIC(Fault)OTL(Pump);]]></Text></Rung>
<Rung Number="4" Type="N"><Text><![CDATA[XIC(Start)OTU(Pump);]]></Text></Rung>
<Rung Number="5" Type="N"><Text><![CDATA[XIC(Seal)OTE(Horn);]]></Text></Rung>
<Rung Number="6" Type="N"><Text><![CDATA[JSR(Sub,0);]]></Text></Rung>
</RLLContent>
</Routine>
<Routine Name="Sub" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[XIC(Fault)OTE(Seal);]]></Text></Rung> <!-- PLCA-P001 seal-in coil driven again in another routine -->
<Rung Number="1" Type="N"><Text><![CDATA[XIC(Fault)OTE(Horn);]]></Text></Rung> <!-- PLCA-P001 alias of an output, two coils -->
<Rung Number="2" Type="N"><Text><![CDATA[EQU(Step,1)MOV(2,Step);]]></Text></Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
