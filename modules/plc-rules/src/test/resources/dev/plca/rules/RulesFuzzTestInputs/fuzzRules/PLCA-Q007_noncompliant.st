FUNCTION F_Rec : INT
VAR_INPUT
    n : INT;
END_VAR
IF n > 0 THEN
    F_Rec := F_Rec(n - 1); // PLCA-Q007
END_IF
END_FUNCTION

FUNCTION F_A : INT
VAR_INPUT
    n : INT;
END_VAR
F_A := F_B(n); // PLCA-Q007
END_FUNCTION

FUNCTION F_B : INT
VAR_INPUT
    n : INT;
END_VAR
F_B := F_A(n);
END_FUNCTION

FUNCTION_BLOCK FB_Tree
METHOD Visit : BOOL
Visit := THIS^.Visit(); // PLCA-Q007
END_METHOD
END_FUNCTION_BLOCK
