ORGANIZATION_BLOCK "Main"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
	"DB_Out".Lamp := "di_Button";
	"DB_Out".Horn := FALSE;
	"Pump_DB"(Enable := TRUE);
END_ORGANIZATION_BLOCK

ORGANIZATION_BLOCK "Cyclic interrupt"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
	"DB_Out".Lamp := NOT "di_Button"; // PLCA-P001
	"DB_Out".Counter += 1;   // read-modify-write: not a coil
END_ORGANIZATION_BLOCK

FUNCTION_BLOCK "FB_Pump"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Enable : Bool;
   END_VAR
   VAR_OUTPUT 
      Running : Bool;
   END_VAR
BEGIN
	#Running := #Enable;
	#Running := FALSE; // PLCA-P001
END_FUNCTION_BLOCK

DATA_BLOCK "DB_Out"
VERSION : 0.1
   STRUCT 
      Lamp : Bool;
      Horn : Bool;
      Counter : Int;
   END_STRUCT;
BEGIN
END_DATA_BLOCK

DATA_BLOCK "Pump_DB"
VERSION : 0.1
"FB_Pump"
BEGIN
END_DATA_BLOCK

ORGANIZATION_BLOCK "Startup"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
	"DB_Out".Lamp := FALSE;   // initialisation before the first cycle: not a double coil
END_ORGANIZATION_BLOCK
