pous:
  FUNCTION_BLOCK Valve
    INPUT EnableIn : BOOL
    INPUT Cmd : BOOL
    INPUT Delay : DINT
    OUTPUT EnableOut : BOOL
    OUTPUT Open : BOOL
    VAR Tmr : TIMER
    VAR Spare1 : DINT
    ROUTINE Prescan
  PROGRAM MainProgram
    VAR Seal : BOOL
    VAR V1 : Valve
    VAR OS : ARRAY[0..3] OF BOOL
    VAR Unused_Work : DINT
    VAR T_Delay : TIMER
    OUTPUT Ready : BOOL
    ROUTINE MainRoutine
    ROUTINE Calc
    ROUTINE Alarms
    ROUTINE Faults
  PROGRAM Monitor
    ROUTINE Main
types:
  STRUCT UDT_Motor { Speed : REAL, Run : BOOL, Fault : BOOL }
gvls:
  Line1 { StartPB : BOOL, StopPB : BOOL, Motor1 : UDT_Motor, Horn : ?, MotorRun : BOOL, Counts : ARRAY[0..9] OF DINT, Line_Name : STRING }
effects:
