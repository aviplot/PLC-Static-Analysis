ORGANIZATION_BLOCK "Main"
TITLE = "Main Program Sweep (Cycle)"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      scaled : Real;
   END_VAR

BEGIN
	"Conveyor_DB"(Start := "di_Start", Stop := "di_Stop", Counters := "DB_Counters".Line1);
	"do_Motor" := "Conveyor_DB".Running;
	#scaled := "FC_Scale"(Raw := "ai_Level");
	"FC_Log"();
	%Q0.1 := %I0.0;
END_ORGANIZATION_BLOCK
